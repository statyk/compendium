# Copy this file to `.env` and edit the values before running `docker compose up`.
# The `.env` file is read by docker-compose at startup; it is NOT copied into any image.

# --- Secrets (change these) -------------------------------------------------

# PostgreSQL password for the `compendium` database role.
POSTGRES_PASSWORD=change-me-postgres

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
COMPENDIUM_JWT_SECRET_KEY=change-me-to-a-long-random-string

# Initial Administrator account created on first startup. Only used if no user
# with this username exists in the database yet. Override the role via
# COMPENDIUM_ADMIN_ROLE (e.g. SystemAdmin or Librarian) for a non-wildcard
# bootstrap. To change the password afterwards, run:
#   docker compose exec compendium compendium user set-password --username admin
COMPENDIUM_ADMIN_USERNAME=admin
COMPENDIUM_ADMIN_PASSWORD=compendium

# --- Ports ------------------------------------------------------------------

# Host ports. Set to something non-privileged (e.g. 8080/8443) to run rootless.
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS --------------------------------------------------------------------

# Common Name baked into the auto-generated self-signed cert. Ignored if you
# drop your own fullchain.pem + privkey.pem into ./certs/ before first run.
COMPENDIUM_CERT_CN=compendium.local

# --- Optional application settings -----------------------------------------

COMPENDIUM_JWT_EXPIRE_MINUTES=480
COMPENDIUM_GUEST_SEARCH_ENABLED=true
COMPENDIUM_DEFAULT_LOAN_PERIOD_DAYS=14
COMPENDIUM_HOLD_EXPIRY_DAYS=30
COMPENDIUM_HOLD_PICKUP_DAYS=3

# TMDb API key (required only if you plan to add films by TMDb ID or title).
COMPENDIUM_TMDB_API_KEY=
