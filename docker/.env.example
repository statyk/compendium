# Copy this file to `.env` and edit the values before running `docker compose up`.
# The `.env` file is read by docker-compose at startup; it is NOT copied into any image.
#
# This file contains env-only settings (DB URL, JWT/encryption keys, TLS
# material) plus env override knobs for secrets (SMTP password, API keys).
# Library name, theme, fines, holds, SMTP host/port, retention windows, and
# the rest are configured at `/ui/admin/settings` (or via the CLI:
# `compendium settings list / get / set / reset`) after first login.
# Secrets (SMTP password, TMDb key, Google Books key) can be set via the
# Admin → System → Secrets page once COMPENDIUM_SECRET_KEY is configured.

# --- Secrets (change these) -------------------------------------------------
#
# Production alternative: use *_FILE variants to keep secrets out of env.
# See docker/README.md § "Secret management" for the file-based pattern.

# PostgreSQL password for the `compendium` database role.
# Production: use POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password instead.
POSTGRES_PASSWORD=change-me-postgres

# Secret used to sign JWTs. REQUIRED — the server refuses to start if this is
# left at the built-in default. Generate with `compendium keygen --jwt`
# (or `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# For first-run/dev only, you may set COMPENDIUM_ALLOW_INSECURE_JWT=1 to bypass
# the check; do NOT use that in prod.
# Production: use COMPENDIUM_JWT_SECRET_KEY_FILE=/run/secrets/compendium_jwt instead.
COMPENDIUM_JWT_SECRET_KEY=change-me-to-a-long-random-string

# Encryption key for secrets stored in the database (SMTP password, API keys).
# Optional — if unset, those settings remain env-only and the Secrets page shows
# a setup banner. Generate with `compendium keygen --secret`.
# COMPENDIUM_SECRET_KEY=

# SMTP password. Set via Admin → System → Secrets when COMPENDIUM_SECRET_KEY is
# configured, or override here (env wins on read). Leave empty to skip SMTP.
COMPENDIUM_SMTP_PASSWORD=

# Initial Administrator account created on first startup. Only used if no user
# with this username exists in the database yet. Override the role via
# COMPENDIUM_ADMIN_ROLE (e.g. SystemAdmin or Librarian) for a non-wildcard
# bootstrap. To change the password afterwards, run:
#   docker compose exec compendium compendium user set-password --username admin
#
# REQUIRED on first run — the container will refuse to start without this set.
# Choose a strong password; there is no default.
COMPENDIUM_ADMIN_USERNAME=admin
COMPENDIUM_ADMIN_PASSWORD=
COMPENDIUM_ADMIN_ROLE=Administrator

# --- Ports ------------------------------------------------------------------

# Host ports. Set to something non-privileged (e.g. 8080/8443) to run rootless.
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS --------------------------------------------------------------------

# Common Name baked into the auto-generated self-signed cert. Ignored if you
# drop your own fullchain.pem + privkey.pem into ./certs/ before first run.
COMPENDIUM_CERT_CN=compendium.local

# --- Other env-only settings -----------------------------------------------

# JWT lifetime in minutes (default 480 = 8 hours).
COMPENDIUM_JWT_EXPIRE_MINUTES=480

# TMDb API key. Set via Admin → System → Secrets when COMPENDIUM_SECRET_KEY is
# configured, or override here (env wins on read).
# COMPENDIUM_TMDB_API_KEY=

# Google Books API key. When set (and COMPENDIUM_BOOK_METADATA_SOURCE_PREFERENCE
# is 'googlebooks', which is the default), Google Books is the primary source for
# book metadata and covers. Free tier: 1 000 requests/day.
# Set via Admin → System → Secrets or override here.
# COMPENDIUM_GOOGLE_BOOKS_API_KEY=

# Book metadata source preference: 'googlebooks' (default — uses GB when key is set)
# or 'openlibrary' (always use OL regardless of key).
# COMPENDIUM_BOOK_METADATA_SOURCE_PREFERENCE=googlebooks

# Metadata cache TTL (days). Successful external lookups (Open Library, MusicBrainz,
# TMDb) are cached in the DB for this many days. Negative (not-found) responses
# are always cached for 24 hours. Default: 30.
# COMPENDIUM_METADATA_CACHE_TTL_DAYS=30

# Hard cap on bulk-import upload size (default 100 MB). Raise if you regularly
# import larger catalogs; env-only so a compromised admin token can't bypass it.
# COMPENDIUM_MAX_UPLOAD_BYTES=104857600

# Comma-separated list of allowed Host header values (TrustedHostMiddleware).
# Unset means any Host is accepted (default, backwards-compatible).
# Production: set to your public hostname(s) to prevent host-header injection.
# Example: COMPENDIUM_ALLOWED_HOSTS=library.example.org,www.library.example.org
# COMPENDIUM_ALLOWED_HOSTS=

# To see every COMPENDIUM_* var Compendium recognizes (env-only AND DB-editable):
#   docker compose exec compendium compendium settings list --all
