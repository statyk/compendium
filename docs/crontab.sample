# Compendium — sample crontab entries (bare-metal install)
#
# Install with:
#   scripts/install-cron.sh
#
# Or paste these lines into `crontab -e`. The installer substitutes:
#   COMPENDIUM_DIR  → absolute path to the project (default: $(pwd))
#   LOG_REDIRECT    → `>> $LOG_FILE 2>&1` for a file path,
#                     or `2>&1 | logger -t compendium-maintenance` for the
#                     systemd journal.
#
# Default LOG_FILE is $HOME/.local/state/compendium/maintenance.log
# (user-writable, no sudo). Override with `install-cron.sh --log-file PATH`
# or `--log-file journal`.

# Drain the email outbox every 5 minutes. Without this, queued notifications
# (hold-ready, due-soon, overdue) sit in the DB forever.
*/5 * * * * cd COMPENDIUM_DIR && uv run compendium maintenance send-queued-notifications --quiet LOG_REDIRECT

# Expire holds whose pickup window has passed.
0 2 * * * cd COMPENDIUM_DIR && uv run compendium maintenance expire-holds --quiet LOG_REDIRECT

# Auto-resume patron-suspended holds whose suspended_until has passed.
5 2 * * * cd COMPENDIUM_DIR && uv run compendium maintenance resume-expired-suspends --quiet LOG_REDIRECT

# Deactivate patrons whose card has expired.
10 2 * * * cd COMPENDIUM_DIR && uv run compendium maintenance deactivate-expired-patrons --quiet LOG_REDIRECT

# Materialize overdue fines so reports see current state.
30 2 * * * cd COMPENDIUM_DIR && uv run compendium maintenance assess-overdue-fines --quiet LOG_REDIRECT

# Queue notification reminders (daily). The 5-minute drain above ships them.
0 8 * * * cd COMPENDIUM_DIR && uv run compendium maintenance queue-due-soon-notices --quiet LOG_REDIRECT
15 8 * * * cd COMPENDIUM_DIR && uv run compendium maintenance queue-overdue-notices --quiet LOG_REDIRECT

# Nightly backup. Rotate / sync to off-machine storage separately.
15 2 * * * cd COMPENDIUM_DIR && uv run compendium backup --output "/var/backups/compendium/$(date +\%Y-\%m-\%d).tar.gz" LOG_REDIRECT

# Optional: monthly retention prune for old audit rows + sent notifications.
# 0 3 1 * * cd COMPENDIUM_DIR && uv run compendium maintenance prune-audit-log --older-than-days 365 --quiet LOG_REDIRECT
# 30 3 1 * * cd COMPENDIUM_DIR && uv run compendium maintenance prune-notifications --older-than-days 180 --quiet LOG_REDIRECT

# Optional: bound the on-disk cover-image cache (weekly).
# 45 3 * * 0 cd COMPENDIUM_DIR && uv run compendium maintenance prune-cover-cache --max-mb 500 --quiet LOG_REDIRECT

# Optional: prune expired metadata-cache rows (weekly). The default TTL is 30 days
# for positive entries and 24h for negative (not-found) entries.
# 50 3 * * 0 cd COMPENDIUM_DIR && uv run compendium maintenance prune-metadata-cache --quiet LOG_REDIRECT

# Optional: prune old failed-login rows (weekly — any row older than 1 day is
# already outside the 5-minute throttle window, so this is just housekeeping).
# 30 3 * * 0 cd COMPENDIUM_DIR && uv run compendium maintenance prune-failed-logins --older-than-days 7 --quiet LOG_REDIRECT

# Optional: prune terminal scan-pairing rows (daily — pairings are ephemeral;
# claim TTL is ~2 min and session TTL is scan_session_minutes, so anything
# older than a day is already dead).
# 35 3 * * * cd COMPENDIUM_DIR && uv run compendium maintenance prune-scan-pairings --older-than-days 7 --quiet LOG_REDIRECT

# Optional: purge trashed works past the retention window (weekly). Works
# deleted more than trash_retention_days ago (default 90) are removed
# permanently; with no flag the command reads the trash_retention_days
# setting (0 disables time-based purging).
# 15 4 * * 0 cd COMPENDIUM_DIR && uv run compendium maintenance purge-trash --quiet LOG_REDIRECT

# Optional: fill missing metadata for newly-imported Works (description,
# cover, publisher, language) from external sources. --limit caps the
# nightly batch; the eligible-set drains to 0 once the catalog is clean.
# 45 3 * * * cd COMPENDIUM_DIR && uv run compendium maintenance refresh-metadata --limit 200 --quiet LOG_REDIRECT
